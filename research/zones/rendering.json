[
  {
    "id": "rd-01",
    "name": "几何与光栅阶段：三角形、draw call 与 overdraw",
    "aliases": [
      "geometry",
      "rasterization",
      "draw call",
      "overdraw",
      "base pass"
    ],
    "type": [
      "通用"
    ],
    "domain": "rendering",
    "category": "管线阶段",
    "summary": "几何阶段把场景三角形提交并光栅化；成本由三角形数、draw call、遮挡与 overdraw 共同决定。",
    "problem": "场景变复杂后 GPU 时间上升，但很难判断是几何、材质还是 overdraw。",
    "mechanism": "可见性裁剪/遮挡剔除 → 提交 draw call → 顶点/光栅化 → 像素着色。Nanite 改变了几何提交方式；半透明/粒子不写深度，overdraw 会成倍放大像素着色成本。",
    "cost": "draw call 受 CPU 提交与状态切换限制；高面数增加顶点/光栅化；overdraw 增加像素着色与带宽。",
    "fit": [
      "所有实时渲染项目",
      "需要先定位 GPU 瓶颈的场景"
    ],
    "unfit": [
      "纯 UI/2D 项目（另看 UI 绘制）"
    ],
    "params": [
      {
        "k": "draw call",
        "v": "千级需关注",
        "note": "平台差异大，按实测"
      },
      {
        "k": "overdraw",
        "v": "半透明层数",
        "note": "粒子/烟尘重点"
      },
      {
        "k": "剔除",
        "v": "视锥/遮挡",
        "note": "降低无效提交"
      }
    ],
    "sources": [
