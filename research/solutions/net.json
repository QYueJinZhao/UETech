      "全版本"
    ],
    "maturity": "生产验证",
    "reliability": "A",
    "level": "深入",
    "summary": "帧同步只同步输入并依赖确定性模拟，带宽低、回放天然；状态同步同步状态快照，权威清晰但带宽高。选择取决于确定性能力、作弊面与重连需求。",
    "problem": "品类需要不同同步模型，但常被“统一架构”绑架；帧同步在浮点/物理不一致时崩坏，状态同步在大量单位时带宽爆炸。",
    "mechanism": "帧同步：所有客户端按相同 tick 应用输入，模拟必须确定性；状态同步：服务器模拟并复制状态，客户端插值/预测。回放/重连在帧同步下需重演输入，状态同步下需快照+增量。",
    "pros": [
      "帧同步带宽低、回放精确",
      "状态同步权威清晰、易反作弊",
      "可按品类混合"
    ],
    "cons": [
      "帧同步确定性要求极高",
      "状态同步带宽/服务器成本高",
      "混合架构复杂度高"
    ],
    "fit": [
      "MOBA/RTS/格斗可用帧同步或确定性状态同步",
      "FPS/搜打撤倾向服务器权威状态同步",
      "开放世界可混合"
    ],
    "unfit": [
      "跨平台浮点差异无法治理的帧同步",
      "大量单位全量状态同步"
    ],
